{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/app/**", "src/instrumentation.ts", "src/instrumentation-node.ts", "src/lib/openapi/document.ts"],
  "extension": [".ts"],
  "reporter": ["text-summary", "lcov"],
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 75
}
