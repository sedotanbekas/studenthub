{
  "openapi": "3.1.0",
  "info": {
    "title": "Student Hub API",
    "version": "v1",
    "description": "API manajemen sekolah multi-sekolah: siswa, admin sekolah, sponsor, super admin. Semua respons memakai envelope {success, data, error, meta}."
  },
  "paths": {
    "/api/v1/meta/enums": {
      "get": {
        "operationId": "getEnumLabels",
        "tags": [
          "Meta"
        ],
        "summary": "Label Bahasa Indonesia untuk semua kode enum",
        "description": "Publik.",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Berhasil.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/EnumLabels"
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "error",
                    "meta"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED / INVALID_JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (termasuk data milik sekolah lain).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Konflik status/duplikat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Pelanggaran aturan bisnis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/provinces": {
      "get": {
        "operationId": "listProvinces",
        "tags": [
          "Wilayah"
        ],
        "summary": "Daftar provinsi (kode Kemendagri)",
        "description": "Aksi POLICY: `region.read`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Berhasil.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Province"
                      }
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "error",
                    "meta"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED / INVALID_JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / TOKEN_EXPIRED / SESSION_INVALID / ACCOUNT_INACTIVE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN / PASSWORD_CHANGE_REQUIRED / SCOPE_MISMATCH / status akun.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (termasuk data milik sekolah lain).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Konflik status/duplikat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Pelanggaran aturan bisnis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/provinces/{code}/cities": {
      "get": {
        "operationId": "listCitiesOfProvince",
        "tags": [
          "Wilayah"
        ],
        "summary": "Daftar kabupaten/kota dalam satu provinsi",
        "description": "Aksi POLICY: `region.read`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/City"
                      }
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "success",
                    "data",
                    "error",
                    "meta"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED / INVALID_JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED / TOKEN_EXPIRED / SESSION_INVALID / ACCOUNT_INACTIVE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN / PASSWORD_CHANGE_REQUIRED / SCOPE_MISMATCH / status akun.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (termasuk data milik sekolah lain).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Konflik status/duplikat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Pelanggaran aturan bisnis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnumLabels": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_FAILED"
              },
              "message": {
                "type": "string",
                "example": "Data tidak valid."
              },
              "details": {
                "anyOf": [
                  {},
                  {
                    "type": "null"
                  }
                ]
              },
              "requestId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "details",
              "requestId"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "null"
          }
        },
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "additionalProperties": false,
        "description": "Bentuk respons gagal untuk semua endpoint."
      },
      "Province": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "additionalProperties": false
      },
      "City": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "provinceCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "provinceCode",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token dari POST /api/v1/auth/login."
      }
    }
  }
}
