# /etc/logrotate.d/studenthub — log cron & backup Student Hub.
# Dipasang oleh `scripts/deploy/bootstrap-vps.sh cron` (root:root, 0644).
# `su`: folder log dimiliki user studenthub (bukan root), logrotate menolak berjalan tanpanya.
# Log aplikasi (stdout/stderr Next) dikelola modul pm2-logrotate milik user studenthub.
/var/log/studenthub/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    su studenthub studenthub
    create 0640 studenthub studenthub
}
