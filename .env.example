# ============================================================
# Student Hub — contoh konfigurasi. Salin ke .env (dev) / .env.test (integration test).
# Produksi & staging: .env dibuat saat bootstrap VPS (chmod 600), TIDAK pernah di-commit.
# ============================================================

# MariaDB. Karakter khusus pada user/password wajib di-URL-encode.
DATABASE_URL="mysql://studenthub:studenthub@127.0.0.1:3307/studenthub_dev"
# Hanya untuk `prisma migrate dev`.
SHADOW_DATABASE_URL="mysql://studenthub:studenthub@127.0.0.1:3307/studenthub_shadow"

# Rahasia (masing-masing >= 32 karakter & harus berbeda). Buat dengan: openssl rand -base64 48
JWT_ACCESS_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter-aaaa"
AD_EVENT_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter-bbbb"
JOB_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter-cccc"
# Kunci AES-256-GCM untuk rahasia TOTP super admin: TEPAT 32 byte, hex 64 karakter (openssl rand -hex 32)
# atau base64. Berbeda dari rahasia lain. JANGAN diganti setelah ada super admin yang mendaftar TOTP
# (rahasia lama tidak bisa didekripsi -> reset TOTP lewat `pnpm db:totp-reset --email ...`).
TOTP_ENC_KEY="ganti-dengan-64-karakter-hex-dari-openssl-rand-hex-32"

# Origin publik aplikasi (tanpa garis miring di akhir).
APP_ORIGIN="http://localhost:3030"
# URL dasar berkas publik (banner iklan). Produksi: https://<domain>/media
PUBLIC_MEDIA_BASE_URL="http://localhost:3030/media"
# Direktori penyimpanan berkas. Produksi WAJIB di luar folder aplikasi.
STORAGE_ROOT="./.storage"

# Push notification: log | memory | expo
PUSH_TRANSPORT="log"
# Opsional, bila Enhanced Push Security aktif di proyek Expo.
EXPO_ACCESS_TOKEN=""

# Basic auth halaman /docs & /api/v1/openapi.json (format user:password). Wajib di produksi.
DOCS_BASIC_AUTH=""

# info | debug | warn | error
LOG_LEVEL="info"

# Kata sandi akun demo untuk `pnpm db:seed:demo` (hanya DB *_dev / *_staging / *_test).
DEMO_PASSWORD=""

# Proses wajib berjalan dalam UTC (tanggal lokal dihitung modul time/zone).
TZ="UTC"
