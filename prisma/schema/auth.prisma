enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  SPONSOR
  STUDENT
  /// Admin Pemerintah Daerah (2026-10-07): pantau (baca saja) sekolah di provinsi/kota akunnya.
  REGION_ADMIN
}

/// WEB = dashboard (transport cookie menyusul di fase frontend); ANDROID/IOS = Bearer.
enum ClientPlatform {
  ANDROID
  IOS
  WEB
}

enum SessionRevokeReason {
  LOGOUT
  TOKEN_REUSE
  PASSWORD_CHANGED
  ACCOUNT_DISABLED
  ADMIN_REVOKED
  REPLACED
}

/// Akun login semua peran. Tidak pernah dihapus (kecuali siswa DRAFT): nonaktifkan lewat isActive.
/// Cakupan (service + CHECK migrasi):
///   SUPER_ADMIN  -> schoolId NULL, sponsorId NULL
///   SCHOOL_ADMIN -> schoolId WAJIB, sponsorId NULL, email WAJIB kecuali admin utama (primarySchoolId)
///   STUDENT      -> schoolId WAJIB, sponsorId NULL, email NULL, tepat satu Student
///   SPONSOR      -> sponsorId WAJIB, schoolId NULL
///   REGION_ADMIN -> schoolId & sponsorId NULL, email WAJIB, regionProvinceCode WAJIB (regionCityCode = admin kota)
///   peran lain   -> regionProvinceCode & regionCityCode NULL
model User {
  id                    String    @id @default(cuid())
  role                  UserRole
  /// Nama tampilan; untuk siswa inilah nama lengkap (tidak diduplikasi di Student).
  name                  String    @db.VarChar(100)
  /// Login staf/sponsor/super admin (kolasi _ci => unik tanpa peka huruf). Siswa login via Student.activeNisn.
  email                 String?   @unique @db.VarChar(191)
  /// Hash bcrypt; di-omit global di src/lib/db.ts.
  passwordHash          String    @db.VarChar(100)
  schoolId              String?
  sponsorId             String?
  isActive              Boolean   @default(true)
  /// true setelah password di-set/di-reset admin; semua endpoint selain allowlist -> 403.
  mustChangePassword    Boolean   @default(false)
  /// Kedaluwarsa kata sandi sementara hasil generate (NULL = bukan sementara).
  tempPasswordExpiresAt DateTime?
  passwordChangedAt     DateTime?
  lastLoginAt           DateTime?
  /// Rahasia TOTP (AES-256-GCM, TOTP_ENC_KEY) — wajib untuk SUPER_ADMIN. Terisi tanpa totpEnabledAt =
  /// pendaftaran belum dikonfirmasi.
  totpSecretEnc         String?   @db.VarChar(255)
  totpEnabledAt         DateTime?
  /// Langkah TOTP (unix/30) terakhir yang diterima; kode dengan langkah <= ini ditolak (anti-replay).
  totpLastUsedStep      Int?
  /// Admin utama sekolah: = schoolId, login memakai NPSN sekolah (email opsional). Unik -> tepat satu
  /// admin utama per sekolah; admin tambahan wajib email (CHECK chk_user_scope).
  primarySchoolId       String?   @unique

  /// Peran akses RBAC (2026-10-07). NULL = peran sistem untuk jenis akunnya (AccessRole.isSystem, baseRole = role).
  /// baseRole peran WAJIB sama dengan role akun (aturan service) -- jenis akun tetap menentukan cakupan data.
  accessRoleId          String?

  /// Wilayah Admin Pemda (2026-10-07): provinsi saja = admin provinsi; + kota = admin kota (kota di provinsi itu).
  regionProvinceCode    String?   @db.VarChar(2)
  regionCityCode        String?   @db.VarChar(5)

  school     School?     @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  regionProvince Province? @relation(fields: [regionProvinceCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  regionCity     City?     @relation(fields: [regionCityCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  sponsor    Sponsor?    @relation("SponsorMembers", fields: [sponsorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accessRole AccessRole? @relation(fields: [accessRoleId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  student                  Student?
  sessions                 AuthSession[]         @relation("SessionOwner")
  impersonatedSessions     AuthSession[]         @relation("SessionImpersonator")
  trustedDevices           TrustedDevice[]
  notifications            Notification[]
  announcementsAuthored    Announcement[]
  reportCardsPublished     ReportCard[]
  leaveReviews             LeaveRequest[]
  invoicesVoided           Invoice[]
  submissionReviews        PaymentSubmission[]
  paymentsRecorded         Payment[]             @relation("PaymentRecordedBy")
  paymentsVoided           Payment[]             @relation("PaymentVoidedBy")
  sponsorsReviewed         Sponsor[]             @relation("SponsorReviewer")
  adsReviewed              Ad[]
  adClicks                 AdClick[]
  topUpReviews             TopUpRequest[]
  ledgerEntries            SponsorLedgerEntry[]
  filesUploaded            StoredFile[]
  auditLogs                AuditLog[]
  loginEvents              LoginEvent[]
  attendanceAnomalyReviews Attendance[]          @relation("AttendanceAnomalyReviewer")
  notificationMutes        NotificationMute[]
  webPushSubscriptions     WebPushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, role, isActive])
  @@index([role, isActive])
  @@index([sponsorId])
  @@index([accessRoleId])
  @@index([regionProvinceCode, regionCityCode])
  @@index([regionCityCode])
}

/// Peran akses RBAC (permintaan pemilik 2026-10-07): daftar hak per aksi POLICY untuk satu jenis akun.
/// Hak efektif = aksi yang diizinkan POLICY untuk baseRole DAN dicentang di peran ini (RBAC hanya
/// mempersempit; jenis akun tetap menentukan cakupan data). Aksi yang belum ada di `knownActions`
/// (fitur baru sesudah peran disimpan): peran sistem -> ikut bawaan POLICY, peran buatan -> tidak.
/// Aturan murni: src/lib/roles/rules.ts.
model AccessRole {
  id           String   @id @default(cuid())
  /// Slug unik ("super-admin", "admin-sekolah", "guru-piket", ...). Tidak berubah setelah dibuat.
  key          String   @unique @db.VarChar(64)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  baseRole     UserRole
  /// Empat peran bawaan (satu per jenis akun): tidak bisa dihapus; hak terkunci tidak bisa dicabut.
  isSystem     Boolean  @default(false)
  /// string[] aksi POLICY yang dicentang.
  permissions  Json
  /// string[] seluruh aksi POLICY saat peran terakhir disimpan.
  knownActions Json
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([baseRole, isSystem])
}

/// Satu login pada satu perangkat = satu "family" refresh token.
/// Token pengganti yang dipakai ulang di luar jendela balapan -> seluruh sesi dicabut (TOKEN_REUSE).
model AuthSession {
  id             String               @id @default(cuid())
  userId         String
  platform       ClientPlatform
  /// Wajib untuk sesi STUDENT di ANDROID/IOS (aturan service).
  deviceId       String?              @db.VarChar(100)
  deviceName     String?              @db.VarChar(100)
  /// Token Expo milik sesi ini. Unik: satu HP hanya menerima push milik SATU sesi aktif.
  expoPushToken  String?              @unique @db.VarChar(255)
  ipAddress      String?              @db.VarChar(45)
  userAgent      String?              @db.VarChar(255)
  lastUsedAt     DateTime             @default(now())
  /// Batas umur absolut family (tidak diperpanjang oleh rotasi).
  expiresAt      DateTime
  revokedAt      DateTime?
  revokeReason   SessionRevokeReason?
  /// "Masuk sebagai" (2026-10-05): super admin yang membuka sesi ini atas nama `userId` (30 menit, tidak dihitung
  /// batas sesi pemilik akun). NULL = sesi login biasa.
  impersonatorId String?

  user                User                 @relation("SessionOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  impersonator        User?                @relation("SessionImpersonator", fields: [impersonatorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  refreshTokens       RefreshToken[]
  webPushSubscription WebPushSubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([deviceId, revokedAt])
  @@index([impersonatorId])
  @@index([expiresAt])
  /// Retensi sesi dicabut > 90 hari (maintenance-daily) tanpa scan seluruh tabel.
  @@index([revokedAt])
}

/// Langganan Web Push (PWA) satu browser untuk satu sesi WEB (N3, keputusan pemilik 2026-10-03). Endpoint unik
/// (hash SHA-256): ganti akun di browser yang sama memindahkan baris ke sesi baru. Hanya sesi hidup yang dikirimi;
/// baris dihapus saat sesinya dicabut, saat push service menjawab 404/410, atau kaskade saat sesi dibersihkan.
model WebPushSubscription {
  id           String   @id @default(cuid())
  userId       String
  sessionId    String   @unique
  endpointHash String   @unique @db.Char(64)
  /// URL push service — setara token: tidak pernah dilog utuh atau dikembalikan API.
  endpoint     String   @db.VarChar(2048)
  p256dh       String   @db.VarChar(128)
  auth         String   @db.VarChar(64)
  userAgent    String?  @db.VarChar(255)
  /// Terakhir didaftarkan ulang atau berhasil dikirimi push.
  lastUsedAt   DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// "Ingat perangkat ini" (30 hari): login dari perangkat ini tidak meminta kode TOTP. Hanya hash SHA-256
/// token opak yang disimpan; dihapus saat semua sesi dicabut (ganti/reset sandi, logout-all, nonaktif).
model TrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.Char(64)
  userAgent String?  @db.VarChar(255)
  ipAddress String?  @db.VarChar(45)
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Hanya hash SHA-256 dari token opak yang disimpan.
model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  /// Diisi saat ditukar (CAS: updateMany where rotatedAt IS NULL). Dipakai lagi => reuse.
  rotatedAt DateTime?

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([rotatedAt])
  @@index([expiresAt])
}

/// Riwayat masuk akun yang dipantau (LOGIN_HISTORY_ROLES di src/lib/login-history/rules.ts; kini SUPER_ADMIN):
/// pembeda SIAPA yang memakai akun — keputusan pemilik 2026-10-02 saat TOTP super admin dimatikan. Berhasil
/// ditulis di transaksi login; gagal (kata sandi salah dsb.) ditulis setelah respons. Lokasi & ISP = perkiraan
/// dari IP (berkas DB-IP Lite lokal), bukan GPS.
model LoginEvent {
  id          String         @id @default(cuid())
  userId      String
  succeeded   Boolean
  /// Kode kegagalan (WRONG_PASSWORD, TOTP_REQUIRED, TOTP_INVALID, ACCOUNT_INACTIVE, ...); NULL bila berhasil.
  failureCode String?        @db.VarChar(32)
  /// Sesi yang dibuka login ini (tanpa relasi: sesi lama dibersihkan maintenance).
  sessionId   String?        @db.VarChar(30)
  platform    ClientPlatform
  ipAddress   String?        @db.VarChar(45)
  userAgent   String?        @db.VarChar(255)
  /// Id perangkat kiriman klien (app: deviceId; web: id browser) — dasar penanda perangkat baru.
  deviceId    String?        @db.VarChar(100)
  deviceName  String?        @db.VarChar(100)
  deviceType  DeviceType?
  browser     String?        @db.VarChar(60)
  os          String?        @db.VarChar(60)
  deviceModel String?        @db.VarChar(60)
  /// Login BERHASIL pertama akun ini dari perangkat tersebut.
  isNewDevice Boolean        @default(false)
  city        String?        @db.VarChar(100)
  region      String?        @db.VarChar(100)
  countryCode String?        @db.Char(2)
  asn         Int?           @db.UnsignedInt
  isp         String?        @db.VarChar(150)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, deviceId])
  @@index([createdAt])
}
